{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "authors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "pdf_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Path"
    },
    "tex_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tex Path"
    },
    "pdf_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Sha256"
    },
    "tex_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tex Sha256"
    },
    "topics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "reading_status": {
      "default": "unread",
      "enum": [
        "unread",
        "reading",
        "completed"
      ],
      "title": "Reading Status",
      "type": "string"
    },
    "analysis_status": {
      "default": "not_analyzed",
      "enum": [
        "not_analyzed",
        "analyzing",
        "ready",
        "failed",
        "needs_review"
      ],
      "title": "Analysis Status",
      "type": "string"
    },
    "imported_at": {
      "title": "Imported At",
      "type": "string"
    },
    "last_opened_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Opened At"
    },
    "page_count": {
      "default": 0,
      "title": "Page Count",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "paper_id",
    "version",
    "title"
  ],
  "title": "Metadata",
  "type": "object"
}
