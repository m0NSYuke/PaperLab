      },
      "required": [
        "paper_id",
        "version"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "section": {
          "enum": [
            "overview",
            "method",
            "mathematics",
            "experiments",
            "relations"
          ],
          "title": "Section",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "paper_fact",
            "paper_interpretation",
            "external_background",
            "inference",
            "uncertain"
