          "maxLength": 100,
          "minLength": 1,
          "title": "Delta Id",
          "type": "string"
        },
        "component": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "prior": {
          "minLength": 1,
          "title": "Prior",
          "type": "string"
        },
        "change": {
          "minLength": 1,
          "title": "Change",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "load_bearing": {
          "enum": [
            "yes",
            "partial",
            "no",
            "untested"
          ],
